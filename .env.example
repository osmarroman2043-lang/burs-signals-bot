# Copiá este archivo a .env y completá lo que tengas.
# Ninguna de estas claves debe subirse a git.

# --- Telegram (para recibir las señales) ---
# 1. En Telegram buscá @BotFather, mandá /newbot y copiá el token.
# 2. Escribile al bot que creaste (cualquier mensaje) y después abrí:
#    https://api.telegram.org/bot<TU_TOKEN>/getUpdates  ->  copiá "chat":{"id":...}
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Capital para calcular el lotaje ---
CAPITAL=1000

# --- Servidor del webhook de TradingView ---
PORT=4322
# Si lo exponés a internet, exigí token: la URL queda /tv-alert?token=...
TV_SECRET=
